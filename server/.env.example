NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_PATH=data.db
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
UPLOAD_DIR=uploads
ENABLE_HTTPS=false

# Cookie 'secure' flag. Defaults to true when NODE_ENV=production.
# Set to "false" only if you MUST serve over plain HTTP in production
# (otherwise refresh cookies are dropped and users re-login on every reload).
COOKIE_SECURE=

# Set to "1" (or "loopback") when running behind a reverse proxy (Nginx/Caddy)
TRUST_PROXY=

# Setup (required for first run)
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=YourSecurePassword123!

# Email (SMTP) - required for forgot/reset password to actually deliver
# APP_URL must be the public URL of the frontend (used in reset links)
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
