NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Hostinger MySQL — use hPanel Managed host (srvXXX.hstgr.io), not localhost
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hr
DATABASE_URL=mysql://user:pass@srvXXX.hstgr.io:3306/hr
MYSQL_SSL=false
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
UPLOAD_DIR=uploads
ENABLE_HTTPS=false

# Cookie 'secure' flag. Defaults to true when NODE_ENV=production.
# Set to "false" only if you MUST serve over plain HTTP in production
# (otherwise refresh cookies are dropped and users re-login on every reload).
COOKIE_SECURE=

# Set to "1" (or "loopback") when running behind a reverse proxy (Nginx/Caddy)
TRUST_PROXY=

# Setup (required for first run)
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=YourSecurePassword123!

# Email (SMTP) — OPTIONAL. If unset, app runs with in-app notifications only.
# Leave flows work without SMTP; forgot/reset password requires SMTP to deliver.
# Set EMAIL_ENABLED=false to force-disable even if SMTP is set.
# APP_URL must be the public URL of the frontend (used in reset links).
APP_URL=http://localhost:3000
EMAIL_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
