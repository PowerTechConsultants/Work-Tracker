# Backend origin for separate Hostinger apps (Vite reads VITE_* at build time).
# In local development the Vite dev proxy forwards /api to localhost:4001 (4000 if free).
VITE_API_URL=http://localhost:4001
# Legacy Next.js name, still honored as fallback (see web/src/lib/env.ts).
NEXT_PUBLIC_API_URL=http://localhost:4001
# Override proxy target when API runs on different port (e.g. VITE_API_PORT=4000)
# VITE_API_PORT=4001
