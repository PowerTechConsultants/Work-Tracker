{
  "name": "employee-work-tracker",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "clean": "node -e \"require('fs').rmSync('web/.next',{recursive:true,force:true})\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "node server/dist/src/server.js",
    "lint": "npm run lint -w server && npm run lint -w web",
    "typecheck": "npm run typecheck -w server",
    "setup": "npm run setup -w server",
    "backup": "npm run backup -w server",
    "backup:list": "npm run backup:list -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
